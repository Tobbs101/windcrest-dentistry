const lines = ["Healthy Smiles,", "One Child at a Time"];

// const lines = ["Windcrest Pediatric", "Dentistry"];

const letterVariants = {
  hidden: { opacity: 0, y: 50 },
  visible: (i: number) => ({
    opacity: 1,
    y: 0,
    transition: {
      delay: i * 0.05,
      duration: 0.5,
      ease: "easeOut",
    },
  }),
};

